{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortKit",
  "version": "1.0.0",
  "identifier": "com.chushijack.portkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortKit",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      },
      {
        "label": "quick-search",
        "title": "PortKit 快速搜索",
        "url": "index.html",
        "width": 560,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNzMzREQ4NTk5RkUyMzYKUldRMjRwOVoyRDF6c2JiMHlBS2NOTVlqQXY2T2lzS2FqWEFTZkNPakpxV0kreGlzNUEvZit1aTEK",
      "endpoints": [
        "https://github.com/chushijack/portkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
